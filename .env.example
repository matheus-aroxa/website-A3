# URL pública do site (sem barra no final). Usada em canonical, Open Graph, sitemap e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.a3solucoesimobiliarias.com.br

# Código de verificação do Google Search Console (opcional).
GOOGLE_SITE_VERIFICATION=

# Segredo do webhook que o CRM chama para atualizar o cache (POST /api/revalidar).
REVALIDATE_SECRET=troque-este-valor

# ---------- Painel administrativo (/admin) ----------
# Admins no formato "usuario:hash", separados por vírgula. Vazio em desenvolvimento (next dev):
# vale o admin padrão usuário "admin" / senha "admin". Em produção é obrigatório. Gere cada entrada com:
#   node scripts/gerar-senha-admin.mjs email@a3.com.br
ADMIN_USUARIOS=
# Chave que assina o cookie de sessão (mínimo 32 caracteres). Gere com:
#   node scripts/gerar-senha-admin.mjs --segredo
# Trocar este valor desconecta todos os admins. Em desenvolvimento, vazio usa um segredo fixo.
ADMIN_SESSAO_SEGREDO=
# Pasta onde o painel grava os ajustes do catálogo e as fotos enviadas (padrão: ./dados).
# Precisa ser gravável e persistir entre deploys.
ADMIN_DADOS_DIR=
