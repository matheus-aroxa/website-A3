# URL pública do site (sem barra no final). Usada em canonical, Open Graph, sitemap e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.a3solucoesimobiliarias.com.br

# Código de verificação do Google Search Console (opcional).
GOOGLE_SITE_VERIFICATION=

# Segredo para invalidar o cache do catálogo à mão (POST /api/revalidar, com "Authorization: Bearer <segredo>").
REVALIDATE_SECRET=troque-este-valor

# ---------- Painel administrativo (/admin) ----------
# Administradores e sessões ficam no banco (db/administradores.sql); não há variável de usuário nem de segredo.
# Pasta onde o painel grava as fotos enviadas (padrão: ./dados). O catálogo fica no banco.
# Precisa ser gravável e persistir entre deploys.
ADMIN_DADOS_DIR=

# Banco PostgreSQL (Supabase). Obrigatório: o catálogo do site e do painel fica nele.
# Em produção (Vercel) use o "Transaction pooler" (Supabase > Connect), que tem IPv4:
#   postgresql://postgres.<projeto>:<senha>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres
# A conexão direta (db.<projeto>.supabase.co) só tem IPv6 e não funciona na Vercel. Em desenvolvimento
# qualquer uma das duas serve. Senha com caracteres especiais (@ # / :) precisa ser codificada na URL.
DATABASE_URL=
# Opcional: conexões por processo (padrão: 3 na Vercel e no build, 5 no resto).
DATABASE_POOL_MAX=

# Só para scripts/copiar-banco.mjs (mudar de banco): URL do banco de destino. Veja docs/migracao-banco.md.
NOVO_DATABASE_URL=
