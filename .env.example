# URL pública do site (sem barra no final). Usada em canonical, Open Graph, sitemap e JSON-LD.
# Em produção tem que ser o endereço de verdade, já registrado e apontado para a Vercel: o Google trata este endereço como o
# "oficial" de cada página. Se ele não existir (hoje www.a3solucoesimobiliarias.com.br não resolve no DNS), as páginas
# não são indexadas direito. Veja docs/deploy-vercel.md.
NEXT_PUBLIC_SITE_URL=https://www.a3solucoesimobiliarias.com.br

# Código de verificação do Google Search Console (opcional).
GOOGLE_SITE_VERIFICATION=

# Segredo para invalidar o cache do catálogo à mão (POST /api/revalidar, com "Authorization: Bearer <segredo>").
# Use um valor aleatório e longo (openssl rand -hex 32). Vazio, a rota recusa tudo.
REVALIDATE_SECRET=

# ---------- Painel administrativo (/admin) ----------
# Administradores e sessões ficam no banco (tabelas em db/schema.sql; como cadastrar: docs/login-admin.md). Não há variável de usuário nem de segredo.
# Fotos do painel: o original e os tamanhos (400/800/1600) vão para o S3 (docs/fotos-s3.md).
# Na Vercel: chave de um usuário IAM que só pode gravar em imoveis/* do bucket (s3:PutObject).
# Em desenvolvimento dá para usar o perfil do AWS CLI no lugar das chaves (AWS_PROFILE=a3).
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=a3
# Opcional: outro bucket (padrão: a3-imoveis-fotos). O endereço público continua o de HOST_S3_FOTOS (hosts-fotos.ts).
S3_FOTOS_BUCKET=
# Pasta das fotos antigas, de antes do S3 (padrão: ./dados). Só é lida; novos envios não gravam mais aqui.
ADMIN_DADOS_DIR=

# Banco PostgreSQL (Supabase). Obrigatório: o catálogo do site e do painel fica nele.
# Em produção (Vercel) use o "Transaction pooler" (Supabase > Connect), que tem IPv4:
#   postgresql://postgres.<projeto>:<senha>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres
# A conexão direta (db.<projeto>.supabase.co) só tem IPv6 e não funciona na Vercel. Em desenvolvimento
# qualquer uma das duas serve. Senha com caracteres especiais (@ # / :) precisa ser codificada na URL.
DATABASE_URL=
# Opcional: conexões por processo (padrão: 3 na Vercel e no build, 5 no resto).
DATABASE_POOL_MAX=

# Medição de visitas dos relatórios do painel (docs/relatorios.md). Só roda no site publicado (VERCEL_ENV=production).
# Use COLETA_ATIVA=1 apenas para testar na máquina local, com um banco de teste.
COLETA_ATIVA=
